{
  "name": "demo-jest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3500",
    "lint:check": "eslint . --max-warnings 0",
    "lint:format": "eslint . --fix --max-warnings 0",
    "start": "next start",
    "test:unit": "jest",
    "test:unit:ci": "jest --ci",
    "test:unit:watch": "jest --watch",
    "types:check": "tsc --noEmit",
    "types:generate": "next typegen"
  },
  "dependencies": {
    "@repo/arithmetic": "workspace:*",
    "@repo/counter": "workspace:*",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@jest/types": "^30.3.0",
    "@repo/config-eslint-typescript": "workspace:*",
    "@repo/config-jest": "workspace:*",
    "@repo/config-next": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
